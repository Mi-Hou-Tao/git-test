#include <iostream>
#include <random>
#include <string>

int main() {
    std::string name;
    std::cout << "请输入你的名字：";
    std::cin >> name;

    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_int_distribution<> luck(1, 100);

    int value = luck(gen);

    std::cout << "\n" << name << " 的今日科研状态：\n";

    if (value <= 30)
        std::cout << "正在调试……但不知道为什么报错。\n";
    else if (value <= 70)
        std::cout << "代码能跑，理论也能跑，暂时不知道哪个更重要。\n";
    else
        std::cout << "灵感爆发！今天适合发明点新东西。\n";

    std::cout << "幸运值：" << value << "/100\n";

    return 0;
}